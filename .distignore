# Excluded from the distributed plugin. One gitignore-style pattern per line,
# the format wp-cli/dist-archive-command reads.
#
# bin/ is deliberately NOT listed. install-nginx-config.sh is plugin functionality,
# not build tooling — inc/server-config.php and inc/cli.php both point the user at it,
# so an archive without it ships a plugin whose own instructions are broken.
#
# composer.json is deliberately NOT listed either. It carries `type: wordpress-plugin`,
# which is what lets this be installed as a composer dependency; require-dev is the only
# dev-facing part of it and composer skips that for an installed package.

# Version control and CI
.git
.gitignore
.distignore
.github

# Dev tooling config
.phpcs.xml
.wp-env.json
package.json
package-lock.json
composer.lock

# Dev dependencies. Neither is needed at runtime — the plugin has no autoloader,
# it requires inc/*.php directly, and composer.lock is ignored for an installed package.
node_modules
vendor

# Internal notes, not user documentation
AGENTS.md
CLAUDE.md
docs
.remember

# Tests
tests

.DS_Store
