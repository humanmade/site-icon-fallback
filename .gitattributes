# Keeps development files out of everything the plugin is distributed as. This list
# decides three of them: the archive GitHub generates for a tag (which is what
# `composer require` downloads), the zip attached to each release, and the contents of
# the `release` branch itself — .github/strip-dev-files.sh applies it there by asking
# `git archive` what survives, so the branch cannot drift from the archives.
#
# Mirrors .distignore, which covers the remaining packaging route (`wp dist-archive`,
# run by hand) — the two lists have to be changed together.
#
# Patterns are matched the way git archive matches them, so a directory entry such as
# /tests covers what is inside it. `git check-attr` does not agree, and is the wrong
# tool for reading this file back.
#
# bin/ and composer.json are deliberately absent — see .distignore for why.

/.gitattributes export-ignore
/.gitignore export-ignore
/.distignore export-ignore
/.github export-ignore

/.phpcs.xml export-ignore
/.wp-env.json export-ignore
/package.json export-ignore
/package-lock.json export-ignore
/composer.lock export-ignore

/AGENTS.md export-ignore
/CLAUDE.md export-ignore
/docs export-ignore
/.remember export-ignore

/tests export-ignore
